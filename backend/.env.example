NODE_ENV=development
TZ='UTC'
PLATFORM=project_name

# Server details
SERVER_TYPE=api
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
SERVER_PROTOCOL=http
SERVER_URL=
SERVER_SOCKET_PORT=3000

# Database details
DB_PROTOCOL=mongodb
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=db_name
DB_USER=db_username
DB_PASS=db_password
dbUrl=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS details
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
UPLOAD_TO_S3_BUCKET=false

# SMTP details
NODEMAILER_HOST=
NODEMAILER_USER=
NODEMAILER_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=

# Super admin login details
SU_EMAIL=admin@example.com
SU_PASS=changeme
SU_NAME=Super Admin

# Swagger authentication credentials
SWAGGER_AUTH_USERNAME=admin
SWAGGER_AUTH_PASSWORD=changeme

# API auth key (sent via X-API-KEY header)
API_AUTH_KEY=changeme_api_key
SOCKET_SERVER_AUTH_KEY=changeme_socket_key

# JWT
JWT_SECRET=changeme_jwt_secret
JWT_EXPIRY=24h
ADMIN_JWT_SIGN_KEY=changeme_admin_jwt_key

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=
ALLOWED_DOMAINS=["http://localhost:3000"]

# Cron
RUN_CRON=false
